# ==============================================================================
# RevOps AI: Environment Configuration Template
# ==============================================================================

# Database Configuration (Supabase PostgreSQL / Relational RLS)
# Supabase Pooler URI (Recommended):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Local Fallback:
# DATABASE_URL=sqlite:///RevOpsAI/data/revops.db

# Dashboard Security (HTTP Basic Authentication)
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambia_esta_clave_segura_123

# Daily Cron Follow-Up Protection
CRON_SECRET_TOKEN=revops_cron_secret_token_abc123

# Multi-Tenancy & Active Environment
ENVIRONMENT=production
DEFAULT_TENANT_ID=tenant_clinicas_madrid

# Meta WhatsApp Cloud API (Graph API v21.0)
META_WA_TOKEN=EAAB...
META_WA_PHONE_ID=10987654321
WHATSAPP_VERIFY_TOKEN=revops_meta_verify_token
WHATSAPP_APP_SECRET=revops_meta_secret_key

# Outbound Email (Resend or Secure SMTP)
RESEND_API_KEY=re_123456789
EMAIL_FROM_ADDRESS=contacto@revops.clinicas.es
EMAIL_SENDER_NAME=Auditor Comercial Clínicas

# CRM Integrations (HubSpot / GoHighLevel)
HUBSPOT_API_KEY=pat-eu1-...
GHL_API_KEY=ghl_...
CRM_WEBHOOK_URL=https://webhook.site/your-crm-endpoint

